<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Re-declares the same tab id every Focus module uses so Magento merges them into one "Focus" tab. -->
        <tab id="focus" translate="label" sortOrder="400" class="focus-tab">
            <label>Focus</label>
        </tab>

        <section id="focus_licensing" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>Licensing</label>
            <tab>focus</tab>
            <resource>Focus_Licensing::config</resource>

            <group id="dashboard" translate="label" sortOrder="1" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>License Dashboard</label>
                <frontend_model>Focus\Licensing\Block\Adminhtml\System\Config\Dashboard</frontend_model>
            </group>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>

                <field id="server_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>License Server URL</label>
                    <comment>Base URL of the Focus_LicenseServer instance, e.g. https://license.beds.co.uk</comment>
                    <validate>required-entry validate-url</validate>
                </field>

                <field id="cache_ttl" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Cache TTL (seconds)</label>
                    <comment>How long to trust a cached license state before the cron refreshes it. Default: 90000 (25 hours).</comment>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="license_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>License Key</label>
                    <comment>Your global Focus license key. After changing it, click Save Config — the license validates automatically and the dashboard above updates.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
            </group>

            <!-- Each button only appears once its destination is set, so an unconfigured store never shows a dead link. -->
            <group id="support" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Renewal &amp; Support</label>

                <field id="renewal_url" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Renewal URL</label>
                    <comment>Page where a customer renews the license, e.g. https://www.beds.co.uk/focus/renew. Leave empty to hide the Renew License button.</comment>
                    <validate>validate-url</validate>
                </field>

                <field id="support_email" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Support Email</label>
                    <comment>Address the Contact Support button writes to. The message is pre-filled with the license diagnostics (key prefix, revision, domain, last result) — never the license key itself. Leave empty to hide the button.</comment>
                    <validate>validate-email</validate>
                </field>
            </group>
        </section>
    </system>
</config>
