<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Each identity shows once until its condition clears, unlike the old per-login flash notices. -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="focus_licensing_expiring" xsi:type="string">Focus\Licensing\Model\System\Message\LicenseExpiring</item>
                <item name="focus_licensing_invalid" xsi:type="string">Focus\Licensing\Model\System\Message\LicenseInvalid</item>
                <item name="focus_licensing_grace_ending" xsi:type="string">Focus\Licensing\Model\System\Message\OfflineGraceEnding</item>
                <item name="focus_licensing_validation_stale" xsi:type="string">Focus\Licensing\Model\System\Message\ValidationStale</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Backend\Model\Menu\Config">
        <plugin name="focus_licensing_admin_menu_guard"
                type="Focus\Licensing\Plugin\Enforcement\AdminMenuGuardPlugin"
                sortOrder="10"/>
    </type>

</config>
