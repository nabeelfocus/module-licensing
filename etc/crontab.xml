<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Daily revalidation of all registered module licenses -->
        <job name="focus_licensing_revalidate"
             instance="Focus\Licensing\Cron\RevalidateLicenses"
             method="execute">
            <schedule>30 1 * * *</schedule>
        </job>
    </group>
</config>
