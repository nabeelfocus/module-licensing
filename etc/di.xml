<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Focus\Licensing\Api\LicenseGuardInterface"
                type="Focus\Licensing\Service\LicenseGuard"/>

    <preference for="Focus\Licensing\Api\ModuleDiscoveryInterface"
                type="Focus\Licensing\Model\ModuleDiscovery"/>

    <preference for="Focus\Licensing\Api\LicenseClientInterface"
                type="Focus\Licensing\Service\LicenseClient"/>

    <preference for="Focus\Licensing\Api\ProtectedModuleRegistryInterface"
                type="Focus\Licensing\Model\Enforcement\ProtectedModuleRegistry"/>

    <type name="Magento\Framework\App\ActionInterface">
        <plugin name="focus_licensing_controller_guard"
                type="Focus\Licensing\Plugin\Enforcement\ControllerGuardPlugin"
                sortOrder="10"/>
    </type>
    <type name="Symfony\Component\Console\Command\Command">
        <plugin name="focus_licensing_command_guard"
                type="Focus\Licensing\Plugin\Enforcement\CommandGuardPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Framework\Event\Invoker\InvokerDefault">
        <plugin name="focus_licensing_observer_guard"
                type="Focus\Licensing\Plugin\Enforcement\ObserverGuardPlugin"
                sortOrder="10"/>
    </type>
    <type name="Magento\Framework\View\Element\AbstractBlock">
        <plugin name="focus_licensing_block_guard"
                type="Focus\Licensing\Plugin\Enforcement\BlockGuardPlugin"
                sortOrder="10"/>
    </type>
    <type name="Focus\Licensing\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Focus\Licensing\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">FocusLicensing</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Focus\Licensing\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
