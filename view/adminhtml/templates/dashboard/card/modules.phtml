<?php
/**
 * Commercial Modules card — filterable and searchable.
 *
 * Every installed commercial module is rendered once; the filter chips and the
 * search box hide and show rows client-side (the list is small and fixed, so a
 * round trip would only add latency). "Needs attention" is the default view:
 * modules that are running but not covered by the license.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Focus\Licensing\ViewModel\Dashboard\ModuleStatus $modules */
$modules = $block->getData('module_status');
/** @var \Focus\Licensing\ViewModel\Dashboard\LicenseState $state */
$state = $block->getData('license_state');

$rows = $modules->getRows();
$counts = $modules->getFilterCounts();

// With no verified license every module would render as restricted, which reads
// as breakage rather than as setup still pending. Collapse to a single line.
$awaitingActivation = $state->getState() === null;

$chips = [
    'attention' => __('Needs attention'),
    'active'    => __('Active'),
    'disabled'  => __('Disabled'),
    'all'       => __('All'),
];
?>
<?php $needsFilter = !empty($rows) && !$awaitingActivation; ?>
<div class="focus-lic__card focus-lic__card--wide" data-card="modules"<?= $needsFilter ? ' data-mage-init=\'{"focusModuleFilter": {}}\'' : '' ?>>
    <div class="focus-lic__card-head">
        <h3><?= $escaper->escapeHtml(__('Commercial Modules')) ?></h3>
        <div class="focus-lic__card-head-actions">
            <span class="focus-lic__muted">
                <?= $escaper->escapeHtml(__('%1 installed · %2 licensed', (string) $modules->getInstalledCount(), (string) $modules->getLicensedCount())) ?>
                &nbsp;·&nbsp;
                <a href="<?= $escaper->escapeUrl($block->getUrl('focus_licensing/modules/index')) ?>">
                    <?= $escaper->escapeHtml(__('View all modules')) ?>
                </a>
            </span>
            <button type="button" class="focus-lic__collapse-toggle" data-role="focus-lic-collapse-toggle"
                    aria-expanded="true" aria-label="<?= $escaper->escapeHtmlAttr(__('Collapse')) ?>"></button>
        </div>
    </div>

    <div class="focus-lic__card-collapsible" data-role="focus-lic-collapsible">
    <?php if (empty($rows)): ?>
        <p class="focus-lic__card-body focus-lic__muted"><?= $escaper->escapeHtml(__('No commercial Focus modules are installed on this store.')) ?></p>
    <?php elseif ($awaitingActivation): ?>
        <div class="focus-lic__awaiting">
            <b><?= $escaper->escapeHtml(__('%1 modules are installed and waiting for activation.', (string) $modules->getInstalledCount())) ?></b>
            <span><?= $escaper->escapeHtml(__('They will be listed here once your license key is saved.')) ?></span>
        </div>
    <?php else: ?>
        <div class="focus-lic__filters">
            <div class="focus-lic__chips" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Filter modules')) ?>">
                <?php foreach ($chips as $filter => $label): ?>
                    <button type="button"
                            class="focus-lic__chip<?= $filter === 'attention' ? ' focus-lic__chip--on' : '' ?>"
                            data-role="focus-lic-chip"
                            data-filter="<?= $escaper->escapeHtmlAttr($filter) ?>"
                            aria-pressed="<?= $filter === 'attention' ? 'true' : 'false' ?>">
                        <?= $escaper->escapeHtml($label) ?>
                        <span class="focus-lic__chip-n"><?= (int) $counts[$filter] ?></span>
                    </button>
                <?php endforeach; ?>
            </div>
            <input type="search"
                   class="focus-lic__search"
                   data-role="focus-lic-search"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Search modules…')) ?>"
                   aria-label="<?= $escaper->escapeHtmlAttr(__('Search modules')) ?>">
        </div>

        <div class="focus-lic__table-wrap">
            <table class="focus-lic__table">
                <thead>
                    <tr>
                        <th><?= $escaper->escapeHtml(__('Module')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Installed')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Enabled')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Licensed')) ?></th>
                        <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                    </tr>
                </thead>
                <tbody data-role="focus-lic-module-rows">
                    <?php foreach ($rows as $row): ?>
                        <?php $needsAttention = $row['enabled'] && !$row['licensed']; ?>
                        <tr data-role="focus-lic-module-row"
                            data-status="<?= $escaper->escapeHtmlAttr($row['status']) ?>"
                            data-attention="<?= $needsAttention ? '1' : '0' ?>"
                            data-name="<?= $escaper->escapeHtmlAttr(strtolower($row['label'] . ' ' . $row['module'])) ?>"
                            <?= $row['enabled'] ? '' : 'class="focus-lic__row--muted"' ?>>
                            <td>
                                <div class="focus-lic__mod-name"><?= $escaper->escapeHtml($row['label']) ?></div>
                                <div class="focus-lic__mod-id"><?= $escaper->escapeHtml($row['module']) ?></div>
                                <?php if ($row['reason'] !== ''): ?>
                                    <div class="focus-lic__muted focus-lic__row-reason"><?= $escaper->escapeHtml($row['reason']) ?></div>
                                <?php endif; ?>
                            </td>
                            <td><span class="focus-lic__yes">✓</span></td>
                            <td>
                                <?php if ($row['enabled']): ?><span class="focus-lic__yes">✓</span>
                                <?php else: ?><span class="focus-lic__no">✕</span><?php endif; ?>
                            </td>
                            <td>
                                <?php if ($row['licensed']): ?><span class="focus-lic__yes">✓</span>
                                <?php else: ?><span class="focus-lic__no">✕</span><?php endif; ?>
                            </td>
                            <td>
                                <span class="focus-lic__badge focus-lic__badge--<?= $escaper->escapeHtmlAttr($row['severity']) ?>">
                                    <?= $escaper->escapeHtml(strtoupper($row['status_label'])) ?>
                                </span>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
            <p class="focus-lic__empty" data-role="focus-lic-empty" hidden
               data-msg-attention="<?= $escaper->escapeHtmlAttr(__('Nothing needs attention — every enabled module is licensed.')) ?>"
               data-msg-none="<?= $escaper->escapeHtmlAttr(__('No modules match this filter.')) ?>"></p>
        </div>
    <?php endif; ?>
    </div>
</div>
