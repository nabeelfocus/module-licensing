<?php
/**
 * Recent Licence Activity card — the local history of licence checks.
 *
 * Hidden until there is something to show, so a freshly activated store is not
 * given an empty table.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Focus\Licensing\ViewModel\Dashboard\Activity $activity */
$activity = $block->getData('activity');
$rows = $activity->getRows();
?>
<?php if (!empty($rows)): ?>
<div class="focus-lic__card focus-lic__card--wide" data-card="activity">
    <div class="focus-lic__card-head">
        <h3><?= $escaper->escapeHtml(__('Recent License Activity')) ?></h3>
        <div class="focus-lic__card-head-actions">
            <span class="focus-lic__muted"><?= $escaper->escapeHtml(__('Last %1 checks on this store', (string) count($rows))) ?></span>
            <button type="button" class="focus-lic__collapse-toggle" data-role="focus-lic-collapse-toggle"
                    aria-expanded="true" aria-label="<?= $escaper->escapeHtmlAttr(__('Collapse')) ?>"></button>
        </div>
    </div>
    <div class="focus-lic__table-wrap" data-role="focus-lic-collapsible">
        <table class="focus-lic__table">
            <thead>
                <tr>
                    <th><?= $escaper->escapeHtml(__('When')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Check')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Result')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Outcome')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <td><?= $escaper->escapeHtml($row['when']) ?></td>
                        <td><?= $escaper->escapeHtml($row['source']) ?></td>
                        <td>
                            <span class="focus-lic__badge focus-lic__badge--<?= $escaper->escapeHtmlAttr($row['severity']) ?>">
                                <?= $escaper->escapeHtml($row['code']) ?>
                            </span>
                        </td>
                        <td class="focus-lic__muted"><?= $escaper->escapeHtml($row['note']) ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
<?php endif; ?>
