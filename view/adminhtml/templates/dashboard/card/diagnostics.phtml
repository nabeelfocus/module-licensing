<?php
/**
 * Diagnostics card — Connection / License / Cache groups plus the live
 * Test Connection results area.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Focus\Licensing\ViewModel\Dashboard\Diagnostics $diagnostics */
$diagnostics = $block->getData('diagnostics');
?>
<div class="focus-lic__card">
    <div class="focus-lic__card-head">
        <h3><?= $escaper->escapeHtml(__('Diagnostics')) ?></h3>
        <button type="button" class="focus-lic__btn" data-role="focus-lic-action" data-action="test">
            <?= $escaper->escapeHtml(__('Test Connection')) ?>
        </button>
    </div>
    <div class="focus-lic__card-body">
        <?php foreach ($diagnostics->getGroups() as $groupLabel => $items): ?>
            <h4 class="focus-lic__diag-group"><?= $escaper->escapeHtml($groupLabel) ?></h4>
            <dl class="focus-lic__kv focus-lic__kv--tight">
                <?php foreach ($items as $item): ?>
                    <dt><?= $escaper->escapeHtml($item['label']) ?></dt>
                    <dd>
                        <?php if (!empty($item['code'])): ?>
                            <code><?= $escaper->escapeHtml($item['value']) ?></code>
                        <?php else: ?>
                            <?= $escaper->escapeHtml($item['value']) ?>
                        <?php endif; ?>
                    </dd>
                <?php endforeach; ?>
            </dl>
        <?php endforeach; ?>

        <div class="focus-lic__test-results" data-role="focus-lic-test-results" aria-live="polite"></div>
    </div>
</div>
