<?php
/**
 * License status strip — answers "is my license healthy?" on one line.
 *
 * Status, plan and expiry read together across a single row; the remaining
 * facts sit in a compact strip below so the modules card starts above the fold.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Focus\Licensing\ViewModel\Dashboard\LicenseState $state */
$state = $block->getData('license_state');
$severity = $state->getStatusSeverity();
$days = $state->getDaysRemaining();
$hasState = $state->getState() !== null;
?>
<div class="focus-lic__card focus-lic__card--hero focus-lic__card--<?= $escaper->escapeHtmlAttr($severity) ?>">
    <div class="focus-lic__hero-row">
        <div class="focus-lic__hero-dot focus-lic__hero-dot--<?= $escaper->escapeHtmlAttr($severity) ?>" role="img"
             aria-label="<?= $escaper->escapeHtmlAttr($state->getStatusLabel()) ?>"></div>

        <div class="focus-lic__hero-main">
            <div class="focus-lic__hero-title">
                <span class="focus-lic__hero-state"><?= $escaper->escapeHtml($state->getStatusLabel()) ?></span>
                <span class="focus-lic__badge focus-lic__badge--<?= $escaper->escapeHtmlAttr($severity) ?>">
                    <?= $escaper->escapeHtml($state->getStatusBadgeLabel()) ?>
                </span>
                <?php if ($state->getPlan() !== null): ?>
                    <span class="focus-lic__badge focus-lic__badge--neutral">
                        <?= $escaper->escapeHtml(strtoupper($state->getPlan())) ?>
                    </span>
                <?php endif; ?>
            </div>
            <p class="focus-lic__hero-desc"><?= $escaper->escapeHtml($state->getStatusDescription()) ?></p>

            <?php
            // Renewal and support are only offered where they are the answer,
            // and only once a destination has been configured — never a dead link.
            $needsHelp = in_array($state->getStatus(), [
                \Focus\Licensing\ViewModel\Dashboard\LicenseState::STATUS_EXPIRING,
                \Focus\Licensing\ViewModel\Dashboard\LicenseState::STATUS_EXPIRED,
                \Focus\Licensing\ViewModel\Dashboard\LicenseState::STATUS_SUSPENDED,
                \Focus\Licensing\ViewModel\Dashboard\LicenseState::STATUS_INVALID,
                \Focus\Licensing\ViewModel\Dashboard\LicenseState::STATUS_VALIDATION_REQUIRED,
            ], true);
            $renewalUrl = $state->getRenewalUrl();
            $supportMailto = $state->getSupportMailto();
            ?>
            <?php if ($needsHelp && ($renewalUrl !== '' || $supportMailto !== '')): ?>
                <div class="focus-lic__hero-actions">
                    <?php if ($renewalUrl !== ''): ?>
                        <a class="focus-lic__btn focus-lic__btn--primary"
                           href="<?= $escaper->escapeUrl($renewalUrl) ?>" target="_blank" rel="noopener noreferrer">
                            <?= $escaper->escapeHtml(__('Renew License')) ?>
                        </a>
                    <?php endif; ?>
                    <?php if ($supportMailto !== ''): ?>
                        <a class="focus-lic__btn" href="<?= $escaper->escapeUrl($supportMailto) ?>">
                            <?= $escaper->escapeHtml(__('Contact Support')) ?>
                        </a>
                    <?php endif; ?>
                </div>
            <?php endif; ?>
        </div>

        <?php if ($hasState && $state->getExpiresAt() !== null): ?>
            <div class="focus-lic__meter">
                <div class="focus-lic__meter-track">
                    <div class="focus-lic__meter-fill focus-lic__meter-fill--<?= $escaper->escapeHtmlAttr($severity) ?>"
                         style="width: <?= (int) $state->getExpiryPercent() ?>%"></div>
                </div>
                <div class="focus-lic__meter-labels">
                    <span><?= $escaper->escapeHtml(__('Expires %1', $state->formatDate($state->getExpiresAt()))) ?></span>
                    <span><?= $escaper->escapeHtml(__('%1 days', (string) max(0, (int) $days))) ?></span>
                </div>
            </div>
        <?php endif; ?>
    </div>

    <?php if ($hasState): ?>
        <dl class="focus-lic__facts">
            <div><dt><?= $escaper->escapeHtml(__('License Key')) ?></dt><dd><code><?= $escaper->escapeHtml($state->getMaskedKey()) ?></code></dd></div>
            <div><dt><?= $escaper->escapeHtml(__('Revision')) ?></dt><dd><?= (int) $state->getRevision() ?></dd></div>
            <div>
                <dt><?= $escaper->escapeHtml(__('Current Domain')) ?></dt>
                <dd>
                    <code><?= $escaper->escapeHtml($state->getDomain()) ?></code>
                    <?php if ($state->getDomainType() !== ''): ?>
                        <span class="focus-lic__badge focus-lic__badge--neutral"><?= $escaper->escapeHtml($state->getDomainType()) ?></span>
                    <?php endif; ?>
                </dd>
            </div>
            <div><dt><?= $escaper->escapeHtml(__('Last Synchronization')) ?></dt><dd><?= $escaper->escapeHtml($state->formatDate($state->getLastSyncedAt(), true)) ?></dd></div>
            <div>
                <dt><?= $escaper->escapeHtml(__('Offline Grace')) ?></dt>
                <dd><?= $escaper->escapeHtml(__('%1 of %2 days', (string) $state->getGraceRemainingDays(), (string) $state->getGraceTotalDays())) ?></dd>
            </div>
        </dl>
    <?php endif; ?>
</div>
