<?php
/**
 * Registered Domains card — the licence's domains as reported at the last
 * synchronisation, with the slot accounting that decides what a merchant can
 * still activate.
 *
 * Domains other than this store can be released from here. This store's own
 * slot is released by the Deactivate button instead, so there is only ever one
 * path to each outcome.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Focus\Licensing\ViewModel\Dashboard\Domains $domains */
$domains = $block->getData('domains');
/** @var \Focus\Licensing\ViewModel\Dashboard\LicenseState $state */
$state = $block->getData('license_state');

$rows = $domains->getRows();
$slotsTotal = $domains->getSlotsTotal();
$slotsUsed = $domains->getSlotsUsed();
?>
<?php if (!empty($rows)): ?>
<div class="focus-lic__card focus-lic__card--wide">
    <div class="focus-lic__card-head">
        <h3><?= $escaper->escapeHtml(__('Registered Domains')) ?></h3>
        <span class="focus-lic__muted">
            <?php if ($slotsTotal > 0): ?>
                <b class="focus-lic__slots"><?= $escaper->escapeHtml(__('%1 of %2 production slots used', (string) $slotsUsed, (string) $slotsTotal)) ?></b>
            <?php else: ?>
                <?= $escaper->escapeHtml(__('As reported by the license server on the last synchronization')) ?>
            <?php endif; ?>
        </span>
    </div>
    <div class="focus-lic__table-wrap">
        <table class="focus-lic__table">
            <thead>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Domain')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Environment')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Activated')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Last Validated')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <td>
                            <code><?= $escaper->escapeHtml($row['domain']) ?></code>
                            <?php if ($row['is_current']): ?>
                                <span class="focus-lic__current-tag"><?= $escaper->escapeHtml(__('THIS STORE')) ?></span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <?php if ($row['type'] !== ''): ?>
                                <span class="focus-lic__badge focus-lic__badge--neutral"><?= $escaper->escapeHtml($row['type']) ?></span>
                            <?php else: ?>—<?php endif; ?>
                        </td>
                        <td><?= $escaper->escapeHtml($state->formatDate($row['activated_at'])) ?></td>
                        <td><?= $escaper->escapeHtml($state->formatDate($row['last_validated_at'], true)) ?></td>
                        <td>
                            <span class="focus-lic__badge focus-lic__badge--<?= $row['status'] === 'active' ? 'ok' : 'neutral' ?>">
                                <?= $escaper->escapeHtml($row['status'] ?: '—') ?>
                            </span>
                        </td>
                        <td class="focus-lic__domain-action">
                            <?php if ($row['is_current']): ?>
                                <span class="focus-lic__muted"><?= $escaper->escapeHtml(__('use Deactivate above')) ?></span>
                            <?php elseif (!$row['uses_slot']): ?>
                                <span class="focus-lic__muted"><?= $escaper->escapeHtml(__('free — no slot used')) ?></span>
                            <?php elseif ($row['releasable']): ?>
                                <button type="button"
                                        class="focus-lic__btn focus-lic__btn--danger focus-lic__btn--sm"
                                        data-role="focus-lic-release"
                                        data-domain="<?= $escaper->escapeHtmlAttr($row['domain']) ?>"
                                        data-confirm="<?= $escaper->escapeHtmlAttr(__('Release the production slot held by %1? That store will switch to restricted mode until it is activated again. This store is not affected.', $row['domain'])) ?>">
                                    <?= $escaper->escapeHtml(__('Release slot')) ?>
                                </button>
                            <?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
<?php endif; ?>
